# ── 3. MP3 GENERATOR ─────────────────────────────────────────────
def generate_mp3s(scripts):
    try:
        from gtts import gTTS
    except ImportError:
        sys.exit("❌  Run: pip install gtts")
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M")
    paths = []
    for name, text in scripts.items():
        filename = OUTPUT_DIR / f"DASGR_{name}_{stamp}.mp3"
        print(f"  🔊  Generating {filename.name} ...")
        gTTS(text=text, lang="en-us", slow=False).save(str(filename))
        print(f"  ✅  {filename.name}  ({filename.stat().st_size/1024:.1f} KB)")
        paths.append(filename)
        time.sleep(0.8)
    return paths, stamp

# ── 4. TIMESTAMP VERIFIER ─────────────────────────────────────────
def verify_timestamps(mp3_paths):
    print("\n  ── Timestamp Verification ──────────────────────────")
    now, all_fresh = datetime.datetime.now(), True
    for path in mp3_paths:
        mtime = datetime.datetime.fromtimestamp(path.stat().st_mtime)
        age_s = (now - mtime).total_seconds()
        fresh = age_s < 3600
        if not fresh: all_fresh = False
        icon = "✅" if fresh else "⚠️  STALE"
        print(f"  {icon}  {path.name}  |  {mtime.strftime('%H:%M:%S EDT')}  |  {int(age_s)}s old")
    return all_fresh

# ── 5. RADIOJAR UPLOADER ──────────────────────────────────────────
def upload_to_radiojar(mp3_paths, stamp):
    if RADIOJAR_TOKEN == "YOUR_RADIOJAR_API_TOKEN":
        print("  ⚠️   Token not set — skipping upload. Fill in lines 32–33 of pipeline.py.")
        return []
    results = []
    for path in mp3_paths:
        title = f"[Eye on the Skies] {path.stem.replace('_', ' ')} — {stamp}"
        print(f"  📡  Uploading {path.name} ...")
        try:
            with open(path, "rb") as f:
                resp = requests.post(
                    f"{RADIOJAR_API_BASE}/station/{RADIOJAR_STATION_ID}/tracks",
                    headers={"Authorization": f"Bearer {RADIOJAR_TOKEN}"},
                    files={"file": (path.name, f, "audio/mpeg")},
                    data={"title": title, "artist": STATION, "album": SEGMENT},
                    timeout=90,
                )
            if resp.status_code in (200, 201):
                track_id = resp.json().get("id", "?")
                print(f"  ✅  Track ID: {track_id}")
                results.append({"file": path.name, "status": "uploaded", "track_id": track_id})
            else:
                print(f"  ❌  {resp.status_code}: {resp.text[:150]}")
                results.append({"file": path.name, "status": "error", "code": resp.status_code})
        except Exception as e:
            print(f"  ❌  {e}")
            results.append({"file": path.name, "status": "exception", "error": str(e)})
        time.sleep(1)
    return results

# ── MAIN ──────────────────────────────────────────────────────────
def main():
    print(f"\n{'═'*60}")
    print(f"  EYE ON THE SKIES — Automation Pipeline")
    print(f"  {STATION}")
    print(f"  {datetime.datetime.now().strftime('%A, %B %-d, %Y  %-I:%M %p EDT')}")
    print(f"{'═'*60}\n")

    print("[1/5]  🌦   Fetching live conditions from The Weather Channel...")
    try:    w = fetch_twc_conditions()
    except Exception as e:
        print(f"  ⚠️  Scrape failed ({e}) — loading cache...")
        w = load_cached_conditions()

    print("\n[2/5]  📝  Building break scripts...")
    scripts = build_scripts(w)
    for k in scripts: print(f"  ✅  {k}")

    print("\n[3/5]  🔊  Generating MP3 files via gTTS...")
    mp3_paths, stamp = generate_mp3s(scripts)

    print("\n[4/5]  🕐  Verifying timestamps...")
    verify_timestamps(mp3_paths)

    print("\n[5/5]  📡  Uploading to RadioJar...")
    upload_to_radiojar(mp3_paths, stamp)

    print(f"\n{'═'*60}")
    print(f"  ✅  Pipeline complete — {len(mp3_paths)} MP3s generated")
    print(f"  📁  Output: {OUTPUT_DIR.resolve()}")
    print(f"  🌦   {w['temp']}°F {w['condition']} | Radar: {w['radar']}")
    print(f"{'═'*60}\n")

if __name__ == "__main__":
    main()
